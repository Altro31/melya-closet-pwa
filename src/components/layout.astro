---
import "#/styles/global.css";
import type { HTMLAttributes } from "astro/types";
import { ClientRouter } from "astro:transitions";
import { ENV } from "varlock/env";

type Props = HTMLAttributes<"body">;

const { "class:list": classList, ...props } = Astro.props;

const PROD = import.meta.env.MODE === "production";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#000000" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <title>Melya Closet</title>
        <ClientRouter />
    </head>
    <body class:list={["antialiased", classList]} {...props}>
        <slot />
        <script is:inline define:vars={{ PROD }}>
            if (PROD && "serviceWorker" in navigator)
                window.addEventListener("load", () => {
                    navigator.serviceWorker.register("/sw.js");
                });
        </script>
    </body>
</html>
