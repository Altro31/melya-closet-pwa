---
import { pwaAssetsHead } from "virtual:pwa-assets/head";
import { pwaInfo } from "virtual:pwa-info";
import "#/styles/global.css";
import type { HTMLAttributes } from "astro/types";
import { ClientRouter } from "astro:transitions";

type Props = HTMLAttributes<"body">;

const { "class:list": classList, ...props } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        {
            pwaAssetsHead.themeColor && (
                <meta
                    name="theme-color"
                    content={pwaAssetsHead.themeColor.content}
                />
            )
        }
        {pwaAssetsHead.links.map((link) => <link {...link} />)}
        <title>Melya Closet</title>
        <ClientRouter />
        <script src="/src/lib/pwa.js"></script>
        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    </head>
    <body class:list={["antialiased", classList]} {...props}>
        <slot />
    </body>
</html>
